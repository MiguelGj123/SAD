{
  "project": {
    "random_state": 42,
    "output_dir": "resultados_soft_clustering"
  },
  "data": {
    "input_csv": "SoundCloud.csv",
    "columns_to_load": ["reviewId", "review", "score", "gender", "location", "date"],
    "score_col": "score",
    "text_col": "review",
    "sentiment_col": "sentimiento",
    "min_words": 6,
    "labels": {
      "positive": "positivo",
      "neutral": "neutro",
      "negative": "negativo"
    },
    "thresholds": {
      "min_positive": 4,
      "exact_neutral": 3
    }
  },
  "features": {
    "max_features": 8000,
    "min_df": 8,
    "max_df": 0.7,
    "ngram_range": [2, 3]
  },
  "features_by_sentiment": {
    "positivo": {
      "min_words": 4,
      "min_df": 6,
      "max_df": 0.75
    },
    "negativo": {
      "min_words": 6,
      "min_df": 8,
      "max_df": 0.7
    }
  },
  "model": {
    "n_topics_range": [3, 4, 5, 6, 7, 8],
    "forced_k_neg": null,
    "processes": 1,
    "eval_max_iter": 15,
    "sklearn_eval_max_iter": 20,
    "final_max_iter": 50,
    "n_top_words": 15
  },
  "visualization": {
    "tsne": {"samples": 1500, "perplexity": 30, "max_iter": 1000},
    "style": {
      "dpi": 200,
      "figsize_eval": [9, 5],
      "figsize_tsne": [12, 8],
      "n_words_legend": 3,
      "colormap": "tab10"
    }
  },
  "export": {
    "separator": ",",
    "neutral_id": -1,
    "top_words_in_csv": 5,
    "filename": "resultados_soft_clustering.csv"
  },
  "stopwords": [
    "it", "the", "to", "and", "is", "this", "that", "for", "of", "in",
    "my", "me", "you", "your", "so", "but", "be", "are", "was",
    "have", "has", "had", "do", "did", "will", "would", "can", "could",
    "with", "on", "at", "by", "as", "an", "or", "if", "up", "out", "all",
    "its", "from", "just", "they", "their", "them", "we", "our", "us",
    "he", "she", "been", "more", "than", "when", "what", "how", "now",
    "get", "got", "even", "also", "very", "too", "still", "after", "before",
    "soundcloud", "sound", "cloud", "app", "music", "song", "listen",
    "use", "great", "love", "one", "every", "much", "lot", "there", "thing",
    "ve", "new", "ever", "like", "experience", "overall", "make", "really",
    "want", "time", "play", "free", "many", "some", "other", "way",
    "without", "because", "well", "good"
  ]
}